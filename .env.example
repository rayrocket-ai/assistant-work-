# Copy to .env and adjust. All values are optional.

# Port the server listens on.
PORT=3000

# Password for the /admin dashboard. If unset, a random password is printed
# in the console each time the server starts — set this for a stable login.
ADMIN_PASSWORD=change-me-to-something-strong

# Optional: override where the SQLite database file is stored.
# DATA_DIR=/var/data

# Optional: secret used to sign admin session tokens. Defaults to a value
# derived from ADMIN_PASSWORD, which is fine for a single-server setup.
# SESSION_SECRET=some-long-random-string
